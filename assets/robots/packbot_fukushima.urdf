<?xml version="1.0"?>
<!-- Original reference geometry based on TEPCO-published PackBot dimensions. -->
<robot name="packbot_fukushima_reference">
  <material name="track"><color rgba="0.04 0.045 0.045 1"/></material>
  <material name="deck"><color rgba="0.47 0.46 0.39 1"/></material>
  <material name="sensor"><color rgba="0.93 0.64 0.08 1"/></material>
  <link name="base_link">
    <inertial><origin xyz="0 0 0.14"/><mass value="31"/><inertia ixx="0.75" ixy="0" ixz="0" iyy="1.15" iyz="0" izz="1.55"/></inertial>
    <visual><origin xyz="0 0.205 0.095"/><geometry><box size="0.52 0.12 0.17"/></geometry><material name="track"/></visual>
    <visual><origin xyz="0 -0.205 0.095"/><geometry><box size="0.52 0.12 0.17"/></geometry><material name="track"/></visual>
    <visual><origin xyz="-0.01 0 0.17"/><geometry><box size="0.43 0.30 0.12"/></geometry><material name="deck"/></visual>
    <collision><origin xyz="0 0 0.12"/><geometry><box size="0.58 0.53 0.20"/></geometry></collision>
  </link>
  <link name="left_drive"><inertial><mass value="1"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.08" length="0.125"/></geometry><material name="deck"/></visual></link>
  <joint name="left_track_joint" type="continuous"><parent link="base_link"/><child link="left_drive"/><origin xyz="0 0.205 0.095"/><axis xyz="0 1 0"/><limit effort="180" velocity="28"/></joint>
  <link name="right_drive"><inertial><mass value="1"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.08" length="0.125"/></geometry><material name="deck"/></visual></link>
  <joint name="right_track_joint" type="continuous"><parent link="base_link"/><child link="right_drive"/><origin xyz="0 -0.205 0.095"/><axis xyz="0 1 0"/><limit effort="180" velocity="28"/></joint>
  <link name="left_flipper"><inertial><mass value="0.6"/><inertia ixx="0.003" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial><visual><origin xyz="0.10 0 0"/><geometry><box size="0.23 0.09 0.075"/></geometry><material name="track"/></visual></link>
  <joint name="left_flipper_joint" type="revolute"><parent link="base_link"/><child link="left_flipper"/><origin xyz="0.22 0.205 0.11"/><axis xyz="0 1 0"/><limit lower="-1.57" upper="1.57" effort="90" velocity="1.5"/></joint>
  <link name="right_flipper"><inertial><mass value="0.6"/><inertia ixx="0.003" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial><visual><origin xyz="0.10 0 0"/><geometry><box size="0.23 0.09 0.075"/></geometry><material name="track"/></visual></link>
  <joint name="right_flipper_joint" type="revolute"><parent link="base_link"/><child link="right_flipper"/><origin xyz="0.22 -0.205 0.11"/><axis xyz="0 1 0"/><limit lower="-1.57" upper="1.57" effort="90" velocity="1.5"/></joint>
  <link name="mast_link"><visual><origin xyz="0 0 0.15"/><geometry><box size="0.045 0.045 0.30"/></geometry><material name="deck"/></visual></link>
  <joint name="mast_pan_joint" type="revolute"><parent link="base_link"/><child link="mast_link"/><origin xyz="0.02 0 0.28"/><axis xyz="0 0 1"/><limit lower="-3.14" upper="3.14" effort="20" velocity="1.5"/></joint>
  <link name="camera_link"><visual><geometry><box size="0.08 0.10 0.07"/></geometry><material name="track"/></visual></link>
  <joint name="camera_tilt_joint" type="revolute"><parent link="mast_link"/><child link="camera_link"/><origin xyz="0.10 0 0.29"/><axis xyz="0 1 0"/><limit lower="-1.4" upper="1.0" effort="10" velocity="1.5"/></joint>
  <link name="lidar_link"><visual><geometry><cylinder radius="0.045" length="0.075"/></geometry><material name="track"/></visual></link>
  <joint name="lidar_fixed" type="fixed"><parent link="base_link"/><child link="lidar_link"/><origin xyz="0.02 0 0.68"/></joint>
  <link name="radiation_link"><visual><geometry><box size="0.16 0.075 0.10"/></geometry><material name="sensor"/></visual></link>
  <joint name="radiation_fixed" type="fixed"><parent link="base_link"/><child link="radiation_link"/><origin xyz="0.03 0.16 0.41"/></joint>
</robot>
